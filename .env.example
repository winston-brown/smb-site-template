# Cloudflare Turnstile — get keys from https://dash.cloudflare.com/sites/turnstile
# Site key is public (used in frontend Turnstile widget)
TURNSTILE_SITE_KEY=1x00000000000000000000AA0000000000000AAA
# Secret key is private (used server-side to verify tokens)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Contact form email forwarding
# The FROM email must be verified in Cloudflare Email Routing dashboard
# https://dash.cloudflare.com/email/routing/overview
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=noreply@yourdomain.com

# Optional: allowed origin for CORS (set to your domain in production)
# ALLOWED_ORIGIN=https://yourdomain.com
