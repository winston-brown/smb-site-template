---
import { siteConfig } from "../config/site.config";
---

{siteConfig.trustItems.length > 0 && (
  <section
    class="border-y border-gray-100 bg-gray-50"
    aria-label="Trust indicators"
  >
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
      <div
        class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3"
      >
        {siteConfig.trustItems.map((item) => (
          <div class="flex items-center gap-2" key={item}>
            <svg
              class="h-4 w-4 shrink-0 text-brand-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M5 13l4 4L19 7"
              />
            </svg>
            <span class="text-sm font-medium text-gray-700">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
