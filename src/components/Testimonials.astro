---
import { siteConfig } from "../config/site.config";
---

{siteConfig.testimonials.length > 0 && (
  <section
    id="testimonials"
    class="section-padding bg-white"
    aria-label="Testimonials"
  >
    <div class="container-narrow">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
          What Our Customers Say
        </h2>
        <p class="mt-4 text-lg text-gray-600">
          Real feedback from real people we've served.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {siteConfig.testimonials.map((testimonial) => (
          <figure class="flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            {testimonial.rating && (
              <div class="mb-3 flex gap-0.5" aria-label={`${testimonial.rating} out of 5 stars`}>
                {Array.from({ length: 5 }, (_, i) => (
                  <svg
                    key={i}
                    class={`h-5 w-5 ${
                      i < testimonial.rating!
                        ? "text-yellow-400"
                        : "text-gray-200"
                    }`}
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
            )}
            <blockquote class="flex-1">
              <p class="text-sm leading-relaxed text-gray-700 italic">
                &ldquo;{testimonial.quote}&rdquo;
              </p>
            </blockquote>
            <figcaption class="mt-4 border-t border-gray-100 pt-4 text-sm">
              <span class="font-semibold text-gray-900">
                {testimonial.name}
              </span>
              {testimonial.location && (
                <span class="text-gray-500">, {testimonial.location}</span>
              )}
            </figcaption>
          </figure>
        ))}
      </div>

      {siteConfig.socialLinks.googleBusiness && (
        <div class="mt-8 text-center">
          <a
            href={siteConfig.socialLinks.googleBusiness}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary text-sm"
          >
            View more reviews on Google
          </a>
        </div>
      )}
    </div>
  </section>
)}
