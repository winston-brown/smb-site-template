---
import { siteConfig } from "../config/site.config";
---

{siteConfig.about.enabled && (
  <section
    id="about"
    class="section-padding bg-white"
    aria-label="About us"
  >
    <div class="container-narrow">
      <div class="mx-auto max-w-3xl">
        <div class="text-center">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
            {siteConfig.about.headline}
          </h2>
        </div>

        <div class="mt-10 flex flex-col items-center gap-8 sm:flex-row sm:items-start">
          {siteConfig.about.image && (
            <div class="shrink-0">
              <img
                src={siteConfig.about.image}
                alt="Owner"
                class="h-48 w-48 rounded-full object-cover shadow-lg"
                width="192"
                height="192"
                loading="lazy"
              />
            </div>
          )}

          <div>
            <p class="text-base leading-relaxed text-gray-700">
              {siteConfig.about.story}
            </p>

            <div class="mt-6 flex flex-wrap gap-4">
              {siteConfig.about.yearsOfExperience && (
                <div class="rounded-lg bg-brand-50 px-4 py-3 text-center">
                  <span class="block text-2xl font-bold text-brand-700">
                    {siteConfig.about.yearsOfExperience}+
                  </span>
                  <span class="text-xs font-medium text-brand-600">
                    Years Experience
                  </span>
                </div>
              )}
              <div class="rounded-lg bg-brand-50 px-4 py-3 text-center">
                <span class="block text-2xl font-bold text-brand-700">
                  {siteConfig.testimonials.length}
                </span>
                <span class="text-xs font-medium text-brand-600">
                  Reviews
                </span>
              </div>
              <div class="rounded-lg bg-brand-50 px-4 py-3 text-center">
                <span class="block text-2xl font-bold text-brand-700">
                  {siteConfig.services.length}
                </span>
                <span class="text-xs font-medium text-brand-600">
                  Services
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
)}
